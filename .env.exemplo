# Copie para .env e ajuste. O .env não vai para o git.

# Pasta do PC onde ficam o bruto, o manifesto e o lakehouse (FORA do OneDrive).
# O docker compose monta esta pasta em /dados dentro do container.
HMDA_DADOS_HOST=C:/dados/hmda

# Certificado extra para HTTPS (só em máquina com antivírus que inspeciona HTTPS,
# como o Norton). Caminho DENTRO do container. Deixe vazio se não precisar.
HMDA_CA_EXTRA=

# Memória do driver Spark (o WSL tem 10 GB; sobra folga para o Python e o SO).
SPARK_DRIVER_MEMORY=6g
